rules_version = '2';

// Вставте ті самі uid, що й у js/config.js (OWNER_UID і READER_UID).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'QekhrmGM5IcM5dSGFS4bPPQgZiy1';
    }
    function isReader() {
      return request.auth != null && request.auth.uid == 'zxtOV2c6elPZ5Okd4sRcA3lIKxU2';
    }

    match /anime/{animeId} {
      // глядач бачить лише тайтли з private == false; позначені «тільки для мене» — лише власник
      allow read: if isOwner() || (isReader() && resource.data.private == false);
      allow write: if isOwner();
    }

    // Усе інше заборонено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
